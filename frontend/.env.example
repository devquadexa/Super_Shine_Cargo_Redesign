# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# For production, update to your actual API URL
# REACT_APP_API_URL=https://api.yourdomain.com/api

# Multi-tenant (Model A) — tenant is resolved from the hostname/subdomain.
# Base domain: for acme.app.example.com the slug 'acme' is taken in front of it.
# REACT_APP_BASE_DOMAIN=app.example.com

# Local-dev override: force a tenant slug when running on localhost (no subdomain).
# Can also be set at runtime with ?tenant=acme in the URL.
# REACT_APP_TENANT=acme
