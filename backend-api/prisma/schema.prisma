  username                                                       String                   @unique(map: "username") @db.VarChar(100)
  password                                                       String                   @db.VarChar(255)
  fullName                                                       String                   @db.VarChar(200)
  role                                                           String                   @db.VarChar(50)
  email                                                          String                   @db.VarChar(200)
  createdDate                                                    DateTime?                @default(now()) @db.DateTime(0)
  isActive                                                       Boolean?                 @default(true)
  isTemporaryPassword                                            String?                  @db.Text
  passwordResetRequired                                          String?                  @db.Text
  lastPasswordChange                                             DateTime?                @db.DateTime(0)
  cashbalancesettlements                                         cashbalancesettlements[]
  cashwithdrawals                                                cashwithdrawals[]
  invoice_reviews_invoice_reviews_clerkIdTousers                 invoice_reviews[]        @relation("invoice_reviews_clerkIdTousers")
  invoice_reviews_invoice_reviews_sentByTousers                  invoice_reviews[]        @relation("invoice_reviews_sentByTousers")
  jobassignments                                                 jobassignments[]
  notifications                                                  notifications[]
  otherexpenses                                                  otherexpenses[]
  passwordresetrequests_passwordresetrequests_requestedByTousers passwordresetrequests[]  @relation("passwordresetrequests_requestedByTousers")
  passwordresetrequests_passwordresetrequests_userIdTousers      passwordresetrequests[]  @relation("passwordresetrequests_userIdTousers")
  pettycashassignments_pettycashassignments_assignedByTousers    pettycashassignments[]   @relation("pettycashassignments_assignedByTousers")
  pettycashassignments_pettycashassignments_assignedToTousers    pettycashassignments[]   @relation("pettycashassignments_assignedToTousers")
}
