# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_SERVER=localhost
DB_PORT=53181
DB_DATABASE=SuperShineCargoDb
DB_USER=SUPER_SHINE_CARGO
DB_PASSWORD=1234SuperShineDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Multi-Tenancy (database-per-tenant) ────────────────────────────────
# Set to 'true' to enable multi-tenant mode. When false the app behaves
# exactly as before (single database from DB_* above).
MULTI_TENANT=false

# Catalog (control-plane) database that stores the tenant registry.
# Falls back to the DB_* connection settings when these are omitted.
CATALOG_DB_DATABASE=SuperShineCargoCatalog
# CATALOG_DB_SERVER=
# CATALOG_DB_PORT=
# CATALOG_DB_USER=
# CATALOG_DB_PASSWORD=

# Base domain for subdomain-based tenant resolution (e.g. app.example.com ->
# acme.app.example.com resolves tenant slug 'acme'). Optional.
APP_BASE_DOMAIN=

# Cache TTL for resolved tenants (ms) and max concurrent tenant DB pools.
TENANT_CACHE_TTL_MS=60000
MAX_TENANT_POOLS=50
